datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum ScreeningStatus {
  SCHEDULED
  PLAYING
  PAUSED
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  VALID_ADMITTED
  CANCELLED_REFUNDED
  INVALID
  ALREADY_ACTIVATED
  INELIGIBLE
}

enum SessionStatus {
  ELIGIBLE
  VERIFIED
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
  FAILED
}

enum CinemaStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
  ARCHIVED
}

enum PartnerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PricingStatus {
  ACTIVE
  PENDING_AGREEMENT
  DEPRECATED
}

enum OperatorRole {
  ADMIN
  MANAGER
  PROJECTIONIST
}

enum AdminRole {
  SUPERADMIN
  AUDITOR
}

enum AuthProvider {
  PHONE
  EMAIL
  GOOGLE
  APPLE
}

model Cinema {
  id               String       @id @default(cuid())
  name             String
  location         String
  timezone         String       @default("Africa/Dar_es_Salaam")
  status           CinemaStatus @default(APPROVED)
  organizationName String?
  contactEmail     String?
  contactPhone     String?
  ticketingSystem  String?      @default("Vista")
  screeningSystem  String?      @default("Dolby TMS")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  screens              Screen[]
  screenings           Screening[]
  rightsAuthorizations RightsAuthorization[]
  usageBillingEvents   UsageBillingEvent[]
  pricingRules         CinemaPricingRule[]
  operatorUsers        OperatorUser[]
  auditEvents          AuditEvent[]
}

model CinemaPricingRule {
  id              String        @id @default(cuid())
  cinemaId        String
  currency        String        @default("TZS")
  pricePerSession Int           @default(500)
  effectiveFrom   DateTime      @default(now())
  effectiveUntil  DateTime?
  status          PricingStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime      @default(now())

  cinema Cinema @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

  @@index([cinemaId])
  @@index([status])
}

model OperatorUser {
  id           String       @id @default(cuid())
  cinemaId     String
  email        String       @unique
  name         String
  passwordHash String
  role         OperatorRole @default(MANAGER)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cinema Cinema @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

  @@index([cinemaId])
  @@index([email])
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPERADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([username])
}

model PartnerApplication {
  id                    String        @id @default(cuid())
  organizationName      String
  contactName           String
  contactEmail          String
  contactPhone          String
  city                  String
  country               String        @default("Tanzania")
  venueCount            Int           @default(1)
  screensCount          Int           @default(1)
  ticketingSystem       String        @default("Vista")
  screeningServer       String        @default("Dolby TMS")
  technicalContactEmail String?
  notes                 String?
  status                PartnerStatus @default(PENDING)
  reviewNotes           String?
  reviewedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([contactEmail])
  @@index([status])
}

model CustomerAccount {
  id                         String       @id @default(cuid())
  phoneNumber                String?      @unique
  email                      String?      @unique
  passwordHash               String?
  name                       String?
  phoneVerified              Boolean      @default(false)
  emailVerified              Boolean      @default(false)
  authProvider               AuthProvider @default(EMAIL)
  sessionToken               String?      @unique
  tokenExpiresAt             DateTime?
  onboardingDone             Boolean      @default(false)
  status                     String       @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, ACTIVE, SUSPENDED, DELETION_REQUESTED
  termsAcceptedVersion       String?
  privacyAcceptedVersion     String?
  termsAcceptedAt            DateTime?
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?
  passwordResetExpiresAt     DateTime?
  themePreference            String       @default("SYSTEM") // LIGHT, DARK, SYSTEM
  notificationPreferences    Json?
  deletionRequestedAt        DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  reminders     ScreeningReminder[]
  breakSessions BreakSession[]

  @@index([phoneNumber])
  @@index([email])
}

model ScreeningReminder {
  id            String   @id @default(cuid())
  customerId    String
  screeningId   String
  ticketNumber  String?
  offsetMinutes Int // 1440 (24h), 60 (1h), 30 (30m)
  isEnabled     Boolean  @default(true)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer  CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  screening Screening       @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@unique([customerId, screeningId, offsetMinutes])
  @@index([customerId])
  @@index([screeningId])
}

model Screen {
  id         String   @id @default(cuid())
  cinemaId   String
  name       String
  totalSeats Int      @default(120)
  createdAt  DateTime @default(now())

  cinema     Cinema      @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  screenings Screening[]

  @@index([cinemaId])
}

model ContentAsset {
  id              String   @id @default(cuid())
  title           String
  durationSeconds Int
  videoUrl        String
  thumbnailUrl    String?
  licenseType     String
  licenseSource   String
  createdAt       DateTime @default(now())

  screenings     Screening[]
  authorizations RightsAuthorization[]
}

model RightsAuthorization {
  id                        String   @id @default(cuid())
  contentAssetId            String
  cinemaId                  String
  isAuthorized              Boolean  @default(true)
  validFrom                 DateTime
  validUntil                DateTime
  maxSessionDurationSeconds Int      @default(900)
  notes                     String?
  createdAt                 DateTime @default(now())

  contentAsset ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  cinema       Cinema       @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

  @@index([contentAssetId, cinemaId])
}

model Screening {
  id                         String          @id @default(cuid())
  cinemaId                   String
  screenId                   String
  contentAssetId             String
  title                      String
  scheduledStart             DateTime
  actualStart                DateTime?
  status                     ScreeningStatus @default(SCHEDULED)
  playbackPositionSeconds    Float           @default(0.0)
  lastPositionUpdatedAt      DateTime?
  totalPausedDurationSeconds Float           @default(0.0)
  isPaused                   Boolean         @default(false)
  pausedAt                   DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  cinema       Cinema                @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  screen       Screen                @relation(fields: [screenId], references: [id], onDelete: Cascade)
  contentAsset ContentAsset          @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  tickets      DemonstrationTicket[]
  sessions     BreakSession[]
  reminders    ScreeningReminder[]

  @@index([cinemaId])
  @@index([screenId])
  @@index([contentAssetId])
}

model DemonstrationTicket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  claimToken   String?      @unique
  screeningId  String
  seatNumber   String
  customerName String
  status       TicketStatus @default(VALID_ADMITTED)
  breakCount   Int          @default(0)
  maxBreaks    Int          @default(2)
  activatedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  screening     Screening      @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  breakSessions BreakSession[]

  @@index([screeningId])
  @@index([claimToken])
}

model OtpChallenge {
  id          String    @id @default(cuid())
  phoneNumber String
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  expiresAt   DateTime
  verifiedAt  DateTime?
  isUsed      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  ipAddress   String?

  smsDeliveries SmsDeliveryAttempt[]

  @@index([phoneNumber])
}

model BreakSession {
  id                  String        @id @default(cuid())
  sessionToken        String        @unique
  ticketId            String
  screeningId         String
  customerId          String?
  breakNumber         Int           @default(1)
  phoneNumber         String?
  startedAt           DateTime      @default(now())
  expiresAt           DateTime
  endedAt             DateTime?
  durationSeconds     Int?
  status              SessionStatus @default(ACTIVE)
  revokedReason       String?
  deviceInfo          String?
  lastHeartbeatAt     DateTime      @default(now())
  lastPositionSeconds Float         @default(0.0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  ticket        DemonstrationTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  screening     Screening           @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  customer      CustomerAccount?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  billingEvents UsageBillingEvent[]
  auditEvents   AuditEvent[]

  @@index([screeningId])
  @@index([ticketId])
  @@index([sessionToken])
  @@index([phoneNumber])
  @@index([customerId])
}

model SmsDeliveryAttempt {
  id                String   @id @default(cuid())
  otpChallengeId    String?
  phoneNumber       String
  messageType       String
  messageBody       String
  provider          String
  status            String
  providerMessageId String?
  cost              String?
  errorDetails      String?
  createdAt         DateTime @default(now())

  otpChallenge OtpChallenge? @relation(fields: [otpChallengeId], references: [id], onDelete: SetNull)

  @@index([phoneNumber])
  @@index([otpChallengeId])
}

model UsageBillingEvent {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  cinemaId     String
  ticketNumber String
  priceTzs     Int      @default(500)
  currency     String   @default("TZS")
  qualifying   Boolean  @default(true)
  isSimulated  Boolean  @default(false)
  disclaimer   String   @default("Standard billing event recorded for verified session")
  createdAt    DateTime @default(now())

  session BreakSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cinema  Cinema       @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

  @@index([cinemaId])
  @@index([ticketNumber])
}

model AuditEvent {
  id         String   @id @default(cuid())
  sessionId  String?
  cinemaId   String?
  eventType  String
  entityType String
  entityId   String?
  actor      String
  details    String
  createdAt  DateTime @default(now())

  session BreakSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  cinema  Cinema?       @relation(fields: [cinemaId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([cinemaId])
  @@index([eventType])
  @@index([createdAt])
}
