# PottyPlay Environment Configuration Template
# Copy this file to .env for local development

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://pottyplay:pottyplay_secret@localhost:5433/pottyplay?schema=public"

# Application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Africa's Talking API Configuration
# In development, leave AT_SIMULATOR_MODE="true" to use the simulated SMS provider.
AT_SIMULATOR_MODE="true"
AT_API_KEY="your_africastalking_api_key_here"
AT_USERNAME="sandbox"
AT_SENDER_ID=""

# Resend Transactional Email Configuration
# If RESEND_API_KEY is empty, emails are logged safely to the server console in development.
RESEND_API_KEY=""
EMAIL_FROM="PottyPlay <onboarding@resend.dev>"

# POS Webhook HMAC Secret
POS_WEBHOOK_SECRET="pottyplay_pos_webhook_secret_key"

# Operational and Commercial Billing Assumptions
DEMO_PRICE_PER_SESSION_TZS="500"
MAX_SESSION_DURATION_SECONDS="900"
OTP_EXPIRY_SECONDS="300"
OTP_MAX_ATTEMPTS="3"

# Node Environment
NODE_ENV="development"
